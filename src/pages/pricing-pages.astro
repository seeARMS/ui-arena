---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import InterfaceComparison from "../components/InterfaceComparison.astro";
import { pricingInterface, pricingOutputs } from "../data/interfaces.js";
---

<BaseLayout
  title="SaaS pricing page leaderboard — UI Arena"
  description="The full leaderboard for UI Arena's SaaS pricing page brief. Compare every model's HTML, screenshots, and Lighthouse + axe scores."
  canonicalPath="/pricing-pages/"
>
  <Header active="interfaces" />
  <InterfaceComparison interfacePrompt={pricingInterface} outputs={pricingOutputs} />
  <Footer />
</BaseLayout>
