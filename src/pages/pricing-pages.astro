---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import InterfaceComparison from "../components/InterfaceComparison.astro";
import { pricingInterface, pricingOutputs } from "../data/interfaces.js";
---

<BaseLayout
  title="SaaS pricing page leaderboard — TasteBench"
  description="The TasteBench leaderboard for the SaaS pricing page scenario. Compare every model's build, source, and Lighthouse + axe scores."
  canonicalPath="/pricing-pages/"
>
  <Header active="scenarios" />
  <InterfaceComparison interfacePrompt={pricingInterface} outputs={pricingOutputs} />
  <Footer />
</BaseLayout>
