---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import InterfaceComparison from "../../../components/InterfaceComparison.astro";
import { interfacePrompts, outputsForInterface } from "../../../data/interfaces.js";

export async function getStaticPaths() {
  return interfacePrompts.map((item) => ({
    params: { scenarioId: item.id },
    props: {
      interfacePrompt: {
        ...item,
        prompt: item.prompt ?? item.summary,
      },
    },
  }));
}

const { interfacePrompt } = Astro.props;
const outputs = outputsForInterface(interfacePrompt.id);
---

<BaseLayout
  title={`${interfacePrompt.title} — TasteBench`}
  description={`Compare AI model outputs for the ${interfacePrompt.title} scenario.`}
  canonicalPath={`/scenarios/${interfacePrompt.id}/`}
>
  <Header active="scenarios" />
  <InterfaceComparison interfacePrompt={interfacePrompt} outputs={outputs} />
  <Footer />
</BaseLayout>
