---
import { generatedResults } from "../../../../data/generated-results.js";

export async function getStaticPaths() {
  return generatedResults
    .filter((result) => result.status === "complete")
    .map((result) => ({
      params: {
        interfaceId: result.interfaceId,
        runId: result.runId,
      },
      props: {
        destination: `/scenarios/${result.interfaceId}/${result.modelId}/`,
      },
    }));
}

const { destination } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <link rel="canonical" href={destination} />
    <title>Redirecting to Model Scenario</title>
    <script define:vars={{ destination }}>
      const target = new URL(destination, window.location.origin);
      target.hash = window.location.hash;
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>Redirecting to <a href={destination}>the model scenario</a>.</p>
  </body>
</html>
