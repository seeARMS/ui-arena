---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { interfacePrompts, pricingOutputs } from "../../data/interfaces.js";

const modelCount = pricingOutputs.length;
---

<BaseLayout
  title="Interfaces — UI Arena"
  description={`The full UI Arena gallery: ${interfacePrompts.length} product-interface briefs, each run across the frontier model lineup.`}
  canonicalPath="/interfaces/"
>
  <Header active="interfaces" />

  <main>
    <section class="page-head">
      <div class="container">
        <div class="crumb">
          <a href="/">UI Arena</a>
          <span>/</span>
          <span>Interfaces</span>
        </div>
        <h1>{interfacePrompts.length} briefs. {modelCount} models. Open one to compare.</h1>
        <div class="page-head-grid">
          <div>
            <p class="lede">
              Each interface in the gallery is a concrete product surface — pricing, dashboards, settings, onboarding. Open one to see how every model in the lineup built it, side by side, with Lighthouse and axe scores.
            </p>
            <div class="badges">
              <span class="badge">▣ {interfacePrompts.length} prompts</span>
              <span class="badge">⚙ {modelCount} models</span>
              <span class="badge">⚡ Static HTML</span>
              <span class="badge">⌗ Open source</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="interface-grid">
          {interfacePrompts.map((item) => (
            <a class="interface-card" href={item.href}>
              <div class="num">{item.number}</div>
              <div class="surface">{item.eyebrow}</div>
              <h2>{item.title}</h2>
              <p>{item.summary}</p>
              <div class="footer">
                <span>{item.status}</span>
                <span class="arrow">↗</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
