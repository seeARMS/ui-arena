---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { interfacePrompts, pricingOutputs, pricingInterface } from "../data/interfaces.js";

const completedRuns = pricingOutputs.filter((o) => !o.pending && o.stateLabel !== "Failed").length;
const featuredSorted = [...pricingOutputs].sort((a, b) => {
  const score = (o) => {
    if (o.pending || o.stateLabel === "Failed") return -1;
    const perf = o.evaluations.find((e) => e.label === "Performance");
    const a11y = o.evaluations.find((e) => e.label === "Accessibility");
    return (perf?.percent ?? 0) + (a11y?.percent ?? 0);
  };
  return score(b) - score(a);
});
const lastUpdate = new Date().toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric" });
---

<BaseLayout canonicalPath="/">
  <Header active="home" />

  <main>
    <section class="hero">
      <div class="container hero-inner stagger-fade-group">
        <div>
          <p class="eyebrow">Open benchmark · UI generation</p>
          <h1>How well do frontier models design <em>UI?</em></h1>
          <p class="lede">
            UI Arena gives the same product-interface brief to GPT-5, Claude Sonnet 4.5, Gemini 3.1, Grok 4.3, and Flash —
            then publishes the live HTML, screenshots, and Lighthouse + axe scores. Same prompt. Five outputs. No vibes.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/interfaces/pricing-ai-coding-assistant/">
              Open the pricing leaderboard →
            </a>
            <a class="button button-secondary" href="/interfaces/">
              Browse {interfacePrompts.length} interfaces
            </a>
          </div>
        </div>
        <aside class="hero-aside">
          <div class="snapshot" aria-label="Arena snapshot">
            <div class="snapshot-head">
              <span>Arena snapshot</span>
              <span class="live"><i></i> Live</span>
            </div>
            <dl>
              <div>
                <dt>Interfaces</dt>
                <dd>{interfacePrompts.length}<small>concrete prompts</small></dd>
              </div>
              <div>
                <dt>Models</dt>
                <dd>{pricingOutputs.length}<small>frontier lineup</small></dd>
              </div>
              <div>
                <dt>Last run</dt>
                <dd>{lastUpdate}<small>auto-indexed</small></dd>
              </div>
              <div>
                <dt>Artifacts</dt>
                <dd>4<small>HTML · PNG · src · eval</small></dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </section>

    <section class="section section-tight">
      <div class="container">
        <div class="metric-strip">
          <div>
            <strong>{interfacePrompts.length}</strong>
            <span>Interface prompts</span>
          </div>
          <div>
            <strong>{pricingOutputs.length}</strong>
            <span>Frontier models</span>
          </div>
          <div>
            <strong>HTML</strong>
            <span>Live, sandboxed previews</span>
          </div>
          <div>
            <strong>Lighthouse + axe</strong>
            <span>Real evaluator scores</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="how-it-works">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">Method</p>
            <h2>How a run works.</h2>
            <p>One prompt, every model, scored on the same machine. The point isn't to crown a winner — it's to make the differences legible.</p>
          </div>
          <a class="text-link" href="https://github.com/colinarms/uiarena" rel="noopener noreferrer">Read the source ↗</a>
        </div>

        <div class="pipeline-list">
          <div>
            <div class="num">01 · Prompt</div>
            <strong>One concrete brief.</strong>
            <p>A product surface like a SaaS pricing page or an admin table — written tightly enough that "good" is verifiable.</p>
          </div>
          <div>
            <div class="num">02 · Run</div>
            <strong>Same input, every model.</strong>
            <p>Routed through OpenRouter so each model sees the identical request. We log time, tokens, and cost per run.</p>
          </div>
          <div>
            <div class="num">03 · Render</div>
            <strong>Live HTML, sandboxed.</strong>
            <p>Outputs become standalone pages with desktop and mobile screenshots. CSP-locked iframes — no same-origin.</p>
          </div>
          <div>
            <div class="num">04 · Score</div>
            <strong>Lighthouse and axe.</strong>
            <p>Each render is scored for performance and accessibility. Violations are linked back to the source line.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-paper" id="featured">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">Featured run</p>
            <h2>SaaS pricing page · AI coding assistant.</h2>
            <p>Three plans, a team upgrade path, usage limits, FAQs, responsive behavior. {pricingOutputs.length} models took a swing.</p>
          </div>
          <a class="text-link" href="/interfaces/pricing-ai-coding-assistant/">Open full leaderboard →</a>
        </div>

        <div class="leaderboard">
          <div class="lb-row head" aria-hidden="true">
            <div>#</div>
            <div>Model</div>
            <div>Scores</div>
            <div>Preview</div>
            <div>Run</div>
            <div>Open</div>
          </div>
          {featuredSorted.slice(0, 5).map((output, index) => {
            const rowClass = `r${(index % 8) + 1}`;
            const isPending = !!output.pending;
            const isFailed = output.stateLabel === "Failed";
            const isComplete = !isPending && !isFailed;
            const perfScore = output.evaluations.find((e) => e.label === "Performance");
            const a11yScore = output.evaluations.find((e) => e.label === "Accessibility");
            const axeScore = output.evaluations.find((e) => e.label === "Axe");
            const timeStat = output.stats?.find((s) => s.label === "Time");
            const costStat = output.stats?.find((s) => s.label === "Cost");
            const tokenStat = output.stats?.find((s) => s.label === "Completion") ?? output.stats?.find((s) => s.label === "Prompt");
            const tone = (item) => !item ? "pending" : item.tone === "good" ? "good" : item.tone === "warn" ? "warn" : item.tone === "bad" ? "bad" : "neutral";
            const medal = !isComplete ? "" : index === 0 ? "gold" : index === 1 ? "silver" : index === 2 ? "bronze" : "";
            const hasPreview = output.previewUrl && output.previewUrl !== "#";
            const hasSource = output.sourceUrl && output.sourceUrl !== "#";
            return (
              <div class={`lb-row ${rowClass} ${isPending ? "is-pending" : ""}`}>
                <div class="rank-cell">
                  {isComplete ? (
                    <span class={`rank-medal ${medal}`}>{index + 1}</span>
                  ) : (
                    <span class="rank">—</span>
                  )}
                </div>
                <div class="model-cell">
                  <span class="swatch" style={`background: ${output.accentSoft};`}></span>
                  <div class="model-name">
                    <strong>{output.model}</strong>
                    <span>{output.family}</span>
                  </div>
                </div>
                <div>
                  <dl class="scores-cell">
                    <div class={`score ${tone(perfScore)}`}>
                      <dt>Perf</dt>
                      <dd>{perfScore ? perfScore.value : "—"}</dd>
                    </div>
                    <div class={`score ${tone(a11yScore)}`}>
                      <dt>A11y</dt>
                      <dd>{a11yScore ? a11yScore.value : "—"}</dd>
                    </div>
                    <div class={`score ${tone(axeScore)}`}>
                      <dt>Axe</dt>
                      <dd>{axeScore ? axeScore.value : "—"}</dd>
                    </div>
                  </dl>
                </div>
                <div class="preview-cell">
                  <div class="lb-preview">
                    {hasPreview ? (
                      <iframe
                        src={output.previewUrl}
                        title={`${output.model} pricing page preview`}
                        sandbox="allow-scripts"
                        loading="lazy"
                      />
                    ) : (
                      <div class="lb-preview-fallback">
                        <div class="bar"><i></i><i></i><i></i></div>
                        <div class="lb-fake">
                          <div class="row1"></div>
                          <div class="row2"></div>
                          <div class="grid"><div></div><div class="pop"></div><div></div></div>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
                <div class="run-cell">
                  {isComplete && timeStat ? (
                    <>
                      <span class="primary">{timeStat.value}</span>
                      <span class="secondary">
                        {tokenStat ? `${tokenStat.value} tok` : ""}
                        {costStat && tokenStat ? " · " : ""}
                        {costStat ? costStat.value : ""}
                      </span>
                    </>
                  ) : isFailed ? (
                    <span class="pending">Run failed</span>
                  ) : (
                    <span class="pending">Not yet run</span>
                  )}
                </div>
                <div class="actions-cell">
                  <a href={output.previewUrl} aria-disabled={!hasPreview ? "true" : undefined}>Preview ↗</a>
                  <a href={output.sourceUrl} aria-disabled={!hasSource ? "true" : undefined}>Source</a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section" id="interfaces">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">Gallery</p>
            <h2>{interfacePrompts.length} interfaces. Pick a fight.</h2>
            <p>Each prompt is a real product surface. Click into one to compare what every model shipped.</p>
          </div>
          <a class="text-link" href="/interfaces/">View all interfaces →</a>
        </div>

        <div class="interface-grid">
          {interfacePrompts.slice(0, 6).map((item) => (
            <a class="interface-card" href={item.href}>
              <div class="num">{item.number}</div>
              <div class="surface">{item.eyebrow}</div>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
              <div class="footer">
                <span>{item.status}</span>
                <span class="arrow">↗</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="split-section">
          <div>
            <p class="eyebrow">Why this exists</p>
            <h2 style="font-size: clamp(28px, 3.6vw, 38px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.05; margin-bottom: 16px;">
              Model demos cherry-pick. UI Arena doesn't.
            </h2>
            <p style="color: var(--ink-soft); font-size: 16px; line-height: 1.6; margin-bottom: 12px;">
              Every model lab ships its best example. UI Arena fixes the brief, runs the same prompt across the lineup, and publishes everything — including the runs that look bad.
            </p>
            <p style="color: var(--ink-soft); font-size: 16px; line-height: 1.6;">
              The point isn't a verdict. It's the patterns: which model writes accessible HTML by default, which one over-engineers the gradient, which one ships 240 lines that beat Sonnet's 412.
            </p>
          </div>
          <div class="prompt-box" style="margin-top: 12px;">
            <header>
              <span>Sample brief · pricing-ai-coding-assistant</span>
              <a href="/interfaces/pricing-ai-coding-assistant/">Open ↗</a>
            </header>
            <div>{pricingInterface.prompt}</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
