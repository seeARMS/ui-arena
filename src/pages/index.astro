---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { interfacePrompts, pricingOutputs, pricingInterface } from "../data/interfaces.js";

const completedRuns = pricingOutputs.filter((o) => !o.pending && o.stateLabel !== "Failed").length;
const featuredSorted = [...pricingOutputs].sort((a, b) => {
  const score = (o) => {
    if (o.pending || o.stateLabel === "Failed") return -1;
    const perf = o.evaluations.find((e) => e.label === "Performance");
    const a11y = o.evaluations.find((e) => e.label === "Accessibility");
    return (perf?.percent ?? 0) + (a11y?.percent ?? 0);
  };
  return score(b) - score(a);
});
const lastUpdate = new Date().toLocaleDateString("en", { month: "short", day: "numeric", year: "numeric" });
---

<BaseLayout canonicalPath="/">
  <Header active="home" />

  <main>
    <section class="hero">
      <div class="container hero-inner stagger-fade-group">
        <div>
          <p class="eyebrow">Open benchmark · Product taste</p>
          <h1>Benchmarking AI <em>taste.</em></h1>
          <p class="lede">
            TasteBench gives the same product scenario to every frontier model — landing pages today, React dashboards and full apps next — then ships the working build, the source, and the scores. Side by side. Same prompt. Every model. No vibes.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/scenarios/pricing-ai-coding-assistant/">
              Open the pricing leaderboard →
            </a>
            <a class="button button-secondary" href="/scenarios/">
              Browse {interfacePrompts.length} scenarios
            </a>
          </div>
        </div>
        <aside class="hero-aside">
          <div class="snapshot" aria-label="Bench snapshot">
            <div class="snapshot-head">
              <span>Bench snapshot</span>
              <span class="live"><i></i> Live</span>
            </div>
            <dl>
              <div>
                <dt>Scenarios</dt>
                <dd>{interfacePrompts.length}<small>concrete prompts</small></dd>
              </div>
              <div>
                <dt>Models</dt>
                <dd>{pricingOutputs.length}<small>frontier lineup</small></dd>
              </div>
              <div>
                <dt>Last run</dt>
                <dd>{lastUpdate}<small>auto-indexed</small></dd>
              </div>
              <div>
                <dt>Stacks</dt>
                <dd>HTML<small>React · Vue next</small></dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </section>

    <section class="section section-tight">
      <div class="container">
        <div class="metric-strip">
          <div>
            <strong>{interfacePrompts.length}</strong>
            <span>Product scenarios</span>
          </div>
          <div>
            <strong>{pricingOutputs.length}</strong>
            <span>Frontier models</span>
          </div>
          <div>
            <strong>Live builds</strong>
            <span>Sandboxed previews</span>
          </div>
          <div>
            <strong>Lighthouse + axe</strong>
            <span>Real evaluator scores</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="how-it-works">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">Method</p>
            <h2>How a run works.</h2>
            <p>One scenario, every model, scored on the same machine. The point isn't to crown a winner — it's to make taste legible.</p>
          </div>
          <a class="text-link" href="https://github.com/colinarms/tastebench" rel="noopener noreferrer">Read the source ↗</a>
        </div>

        <div class="pipeline-list">
          <div>
            <div class="num">01 · Scenario</div>
            <strong>One concrete product.</strong>
            <p>A pricing page, a creator dashboard, an onboarding flow — specified tightly enough that "good" is verifiable, but open enough for every model to pick its own approach.</p>
          </div>
          <div>
            <div class="num">02 · Run</div>
            <strong>Same input, every model.</strong>
            <p>Routed through OpenRouter so each model sees the identical request. We log time, tokens, and cost per run.</p>
          </div>
          <div>
            <div class="num">03 · Render</div>
            <strong>Live HTML, sandboxed.</strong>
            <p>Outputs become standalone pages with desktop and mobile screenshots. CSP-locked iframes — no same-origin.</p>
          </div>
          <div>
            <div class="num">04 · Score</div>
            <strong>Lighthouse and axe.</strong>
            <p>Each render is scored for performance and accessibility. Violations are linked back to the source line.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-paper" id="featured">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">Featured scenario</p>
            <h2>SaaS pricing page · AI coding assistant.</h2>
            <p>Three plans, a team upgrade path, usage limits, FAQs, responsive behavior. {pricingOutputs.length} models took a swing.</p>
          </div>
          <a class="text-link" href="/scenarios/pricing-ai-coding-assistant/">Open full leaderboard →</a>
        </div>

        <div class="leaderboard">
          <div class="lb-row head" aria-hidden="true">
            <div>#</div>
            <div>Model</div>
            <div>Scores</div>
            <div>Preview</div>
            <div>Run</div>
          </div>
          {featuredSorted.slice(0, 5).map((output, index) => {
            const rowClass = `r${(index % 8) + 1}`;
            const isPending = !!output.pending;
            const isFailed = output.stateLabel === "Failed";
            const isComplete = !isPending && !isFailed;
            const perfScore = output.evaluations.find((e) => e.label === "Performance");
            const a11yScore = output.evaluations.find((e) => e.label === "Accessibility");
            const axeScore = output.evaluations.find((e) => e.label === "Axe");
            const timeStat = output.stats?.find((s) => s.label === "Time");
            const costStat = output.stats?.find((s) => s.label === "Cost");
            const tone = (item) => !item ? "pending" : item.tone === "good" ? "good" : item.tone === "warn" ? "warn" : item.tone === "bad" ? "bad" : "neutral";
            const medal = !isComplete ? "" : index === 0 ? "gold" : index === 1 ? "silver" : index === 2 ? "bronze" : "";
            const hasScreenshot = output.screenshotUrl && output.screenshotUrl !== "#";
            const RowTag = isComplete ? "a" : "div";
            const rowProps = isComplete
              ? { href: output.previewUrl, "aria-label": `Open ${output.model} run details` }
              : {};
            return (
              <RowTag class={`lb-row ${rowClass} ${isPending ? "is-pending" : ""} ${isComplete ? "is-clickable" : ""}`} {...rowProps}>
                <div class="rank-cell">
                  {isComplete ? (
                    <span class={`rank-medal ${medal}`}>{index + 1}</span>
                  ) : (
                    <span class="rank">—</span>
                  )}
                </div>
                <div class="model-cell">
                  <span class="swatch" style={`background: ${output.accentSoft};`}></span>
                  <div class="model-name">
                    <strong>{output.model}</strong>
                    <span>{output.family}</span>
                  </div>
                </div>
                <div>
                  <dl class="scores-cell">
                    <div class={`score ${tone(perfScore)}`}>
                      <dt>Perf</dt>
                      <dd>{perfScore ? perfScore.value : "—"}</dd>
                    </div>
                    <div class={`score ${tone(a11yScore)}`}>
                      <dt>A11y</dt>
                      <dd>{a11yScore ? a11yScore.value : "—"}</dd>
                    </div>
                    <div class={`score ${tone(axeScore)}`}>
                      <dt>Axe</dt>
                      <dd>{axeScore ? axeScore.value.split(" ")[0] : "—"}</dd>
                    </div>
                  </dl>
                </div>
                <div class="preview-cell">
                  <div class="lb-preview">
                    {hasScreenshot ? (
                      <img
                        src={output.screenshotUrl}
                        alt={`${output.model} pricing page screenshot`}
                        loading="lazy"
                      />
                    ) : (
                      <div class="lb-preview-fallback">
                        <div class="bar"><i></i><i></i><i></i></div>
                        <div class="lb-fake">
                          <div class="row1"></div>
                          <div class="row2"></div>
                          <div class="grid"><div></div><div class="pop"></div><div></div></div>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
                <div class="run-cell">
                  {isComplete && (timeStat || costStat) ? (
                    <>
                      {timeStat && (
                        <div class="run-stat">
                          <span class="run-stat-label">Time</span>
                          <span class="run-stat-value">{timeStat.value}</span>
                        </div>
                      )}
                      {costStat && (
                        <div class="run-stat">
                          <span class="run-stat-label">Cost</span>
                          <span class="run-stat-value">{costStat.value}</span>
                        </div>
                      )}
                    </>
                  ) : isFailed ? (
                    <span class="run-cell-empty">Run failed</span>
                  ) : (
                    <span class="run-cell-empty">Not yet run</span>
                  )}
                </div>
              </RowTag>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section" id="scenarios">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">Scenarios</p>
            <h2>{interfacePrompts.length} product scenarios. Pick a fight.</h2>
            <p>Each scenario is a concrete product surface — landing pages, dashboards, settings, onboarding. Click in to see how every model built it.</p>
          </div>
          <a class="text-link" href="/scenarios/">View all scenarios →</a>
        </div>

        <div class="interface-grid">
          {interfacePrompts.slice(0, 6).map((item) => (
            <a class="interface-card" href={item.href}>
              <div class="num">{item.number}</div>
              <div class="surface">{item.eyebrow}</div>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
              <div class="footer">
                <span>{item.status}</span>
                <span class="arrow">↗</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="split-section">
          <div>
            <p class="eyebrow">Why this exists</p>
            <h2 style="font-size: clamp(28px, 3.6vw, 38px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.05; margin-bottom: 16px;">
              Model demos cherry-pick. TasteBench doesn't.
            </h2>
            <p style="color: var(--ink-soft); font-size: 16px; line-height: 1.6; margin-bottom: 12px;">
              Every model lab ships its best example. TasteBench fixes the scenario, runs the same prompt across the lineup, and publishes everything — including the builds that look bad.
            </p>
            <p style="color: var(--ink-soft); font-size: 16px; line-height: 1.6;">
              The point isn't a verdict. It's the patterns: which model writes accessible markup by default, which one over-engineers the gradient, which one ships 240 lines that beat Sonnet's 412.
            </p>
          </div>
          <div class="prompt-box" style="margin-top: 12px;">
            <header>
              <span>Sample scenario · pricing-ai-coding-assistant</span>
              <a href="/scenarios/pricing-ai-coding-assistant/">Open ↗</a>
            </header>
            <div class="prompt-text">{pricingInterface.prompt}</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
