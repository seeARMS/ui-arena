---
const { output, index = 0 } = Astro.props;
const rowClass = `r${(index % 8) + 1}`;
const hasScreenshot = output.screenshotUrl && output.screenshotUrl !== "#";

const isPending = !!output.pending;
const isFailed = output.stateLabel === "Failed";
const isComplete = !isPending && !isFailed;

const perfScore = output.evaluations.find((e) => e.label === "Performance");
const a11yScore = output.evaluations.find((e) => e.label === "Accessibility");
const axeScore = output.evaluations.find((e) => e.label === "Axe");
const tasteScore = typeof output.tasteScore === "number"
  ? {
      label: "Taste",
      value: output.tasteScore.toFixed(1),
      tone: output.tasteScore >= 66 ? "good" : output.tasteScore >= 45 ? "warn" : "bad",
    }
  : null;

function toneClass(item) {
  if (!item) return "pending";
  return item.tone === "good" ? "good" : item.tone === "warn" ? "warn" : item.tone === "bad" ? "bad" : "neutral";
}

const timeStat = output.stats?.find((s) => s.label === "Time");
const costStat = output.stats?.find((s) => s.label === "Cost");

const rankLabel = index + 1;
const medalClass = !isComplete
  ? ""
  : index === 0
    ? "gold"
    : index === 1
      ? "silver"
      : index === 2
        ? "bronze"
        : "";

const Tag = isComplete ? "a" : "div";
const linkProps = isComplete
  ? { href: output.previewUrl, "aria-label": `Open ${output.model} run details` }
  : {};
---

<Tag class={`lb-row ${rowClass} ${isPending ? "is-pending" : ""} ${isComplete ? "is-clickable" : ""}`} {...linkProps}>
  <div class="rank-cell">
    {isComplete ? (
      <span class={`rank-medal ${medalClass}`}>{rankLabel}</span>
    ) : (
      <span class="rank">—</span>
    )}
  </div>

  <div class="model-cell">
    <span class="swatch" style={`background: ${output.accentSoft};`}></span>
    <div class="model-name">
      <strong>{output.model}</strong>
      <span>{output.family} · {output.modelId}</span>
    </div>
  </div>

  <div>
    <dl class="scores-cell">
      <div class={`score ${toneClass(tasteScore)}`}>
        <dt>Taste</dt>
        <dd>{tasteScore ? tasteScore.value : "—"}</dd>
      </div>
      <div class={`score ${toneClass(perfScore)}`}>
        <dt>Perf</dt>
        <dd>{perfScore ? perfScore.value : "—"}</dd>
      </div>
      <div class={`score ${toneClass(a11yScore)}`}>
        <dt>A11y</dt>
        <dd>{a11yScore ? a11yScore.value : "—"}</dd>
      </div>
      <div class={`score ${toneClass(axeScore)}`}>
        <dt>Axe</dt>
        <dd>{axeScore ? axeScore.value.split(" ")[0] : "—"}</dd>
      </div>
    </dl>
  </div>

  <div class="preview-cell">
    <div class="lb-preview">
      {hasScreenshot ? (
        <img
          src={output.screenshotUrl}
          alt={`${output.model} generated scenario screenshot`}
          loading="lazy"
        />
      ) : (
        <div class="lb-preview-fallback">
          <div class="bar"><i></i><i></i><i></i></div>
          <div class="lb-fake">
            <div class="row1"></div>
            <div class="row2"></div>
            <div class="grid">
              <div></div>
              <div class="pop"></div>
              <div></div>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>

  <div class="run-cell">
    {isComplete && (timeStat || costStat) ? (
      <>
        {timeStat && (
          <div class="run-stat">
            <span class="run-stat-label">Time</span>
            <span class="run-stat-value">{timeStat.value}</span>
          </div>
        )}
        {costStat && (
          <div class="run-stat">
            <span class="run-stat-label">Cost</span>
            <span class="run-stat-value">{costStat.value}</span>
          </div>
        )}
      </>
    ) : isFailed ? (
      <span class="run-cell-empty">Run failed</span>
    ) : (
      <span class="run-cell-empty">Not yet run</span>
    )}
  </div>
</Tag>
