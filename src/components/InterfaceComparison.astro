---
import PricingOutputCard from "./PricingOutputCard.astro";

const { interfacePrompt, outputs } = Astro.props;

const completedCount = outputs.filter((o) => !o.pending && o.stateLabel !== "Failed").length;
const failedCount = outputs.filter((o) => o.stateLabel === "Failed").length;
const pendingCount = outputs.length - completedCount - failedCount;

const sorted = [...outputs].sort((a, b) => {
  const score = (o) => {
    if (o.pending || o.stateLabel === "Failed") return -1;
    const perf = o.evaluations.find((e) => e.label === "Performance");
    const a11y = o.evaluations.find((e) => e.label === "Accessibility");
    return (perf?.percent ?? 0) + (a11y?.percent ?? 0);
  };
  return score(b) - score(a);
});

const lastRun = outputs
  .map((o) => o.stats?.find((s) => s.label === "Time"))
  .filter(Boolean).length;
---

<main>
  <section class="page-head">
    <div class="container">
      <div class="crumb">
        <a href="/scenarios/">Scenarios</a>
        <span>/</span>
        <span>{interfacePrompt.number}</span>
      </div>
      <h1><span class="id">{interfacePrompt.number}.</span> {interfacePrompt.title}</h1>

      <div class="page-head-grid">
        <div>
          <p class="lede">
            {outputs.length} models received the same scenario. Below: a leaderboard of their builds, ranked by aggregate of Lighthouse performance and accessibility.
          </p>
          <div class="badges">
            <span class="badge">▣ {interfacePrompt.eyebrow}</span>
            <span class="badge">⚙ {outputs.length} models</span>
            <span class="badge">▤ {completedCount} ranked</span>
            {pendingCount > 0 && <span class="badge">○ {pendingCount} queued</span>}
            {failedCount > 0 && <span class="badge">✕ {failedCount} failed</span>}
            {interfacePrompt.stack && <span class="badge">⌗ {interfacePrompt.stack}</span>}
          </div>
        </div>
        <div class="prompt-box" data-prompt-box data-expanded="false">
          <header>
            <span>Prompt · v1</span>
            <div class="prompt-actions">
              <button
                type="button"
                class="prompt-copy"
                data-prompt-toggle
                aria-expanded="false"
                aria-label="Expand prompt"
              >
                <span data-toggle-label>Expand</span>
              </button>
              <button
                type="button"
                class="prompt-copy"
                data-copy-prompt
                data-prompt={interfacePrompt.prompt}
                aria-label="Copy prompt to clipboard"
              >
                <span data-copy-label>Copy</span>
              </button>
            </div>
          </header>
          <div class="prompt-text" data-prompt-text>{interfacePrompt.prompt}</div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="controls">
        <div class="group">
          <span class="controls-label">View</span>
          <div class="seg" role="tablist" aria-label="Display mode">
            <button type="button" data-view-option="leaderboard" aria-pressed="true">Leaderboard</button>
            <button type="button" data-view-option="grid" aria-pressed="false">Grid</button>
          </div>
        </div>
        <div class="group">
          <span class="controls-label">Sort by</span>
          <select class="sort-select" aria-label="Sort outputs">
            <option>Aggregate</option>
            <option>Performance</option>
            <option>Accessibility</option>
            <option>Speed</option>
            <option>Cost</option>
          </select>
        </div>
      </div>

      <div class="leaderboard" data-view="leaderboard">
        <div class="lb-row head" aria-hidden="true">
          <div>#</div>
          <div>Model</div>
          <div>Scores</div>
          <div>Preview</div>
          <div>Run</div>
        </div>
        {sorted.map((output, index) => (
          <PricingOutputCard
            output={output}
            index={index}
            interfaceId={interfacePrompt.id}
          />
        ))}
      </div>
    </div>
  </section>
</main>

<script>
  const board = document.querySelector(".leaderboard");
  const buttons = Array.from(document.querySelectorAll("[data-view-option]"));

  function setView(view) {
    board?.setAttribute("data-view", view);
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(button.dataset.viewOption === view));
    }
  }

  for (const button of buttons) {
    button.addEventListener("click", () => {
      setView(button.dataset.viewOption ?? "leaderboard");
    });
  }

  const promptBox = document.querySelector("[data-prompt-box]");
  const promptToggle = promptBox?.querySelector("[data-prompt-toggle]");
  if (promptBox && promptToggle) {
    const labelEl = promptToggle.querySelector("[data-toggle-label]");
    promptToggle.addEventListener("click", () => {
      const expanded = promptBox.getAttribute("data-expanded") === "true";
      const next = !expanded;
      promptBox.setAttribute("data-expanded", String(next));
      promptToggle.setAttribute("aria-expanded", String(next));
      promptToggle.setAttribute("aria-label", next ? "Collapse prompt" : "Expand prompt");
      if (labelEl) labelEl.textContent = next ? "Collapse" : "Expand";
    });
  }

  const copyButton = document.querySelector("[data-copy-prompt]");
  if (copyButton) {
    const labelEl = copyButton.querySelector("[data-copy-label]");
    const promptText = copyButton.dataset.prompt ?? "";
    let resetTimer;

    const flash = (text) => {
      if (!labelEl) return;
      const original = "Copy";
      labelEl.textContent = text;
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        labelEl.textContent = original;
      }, 1400);
    };

    copyButton.addEventListener("click", async () => {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(promptText);
        } else {
          const ta = document.createElement("textarea");
          ta.value = promptText;
          ta.setAttribute("readonly", "");
          ta.style.position = "absolute";
          ta.style.left = "-9999px";
          document.body.appendChild(ta);
          ta.select();
          document.execCommand("copy");
          ta.remove();
        }
        flash("Copied");
      } catch {
        flash("Press ⌘C");
      }
    });
  }
</script>
