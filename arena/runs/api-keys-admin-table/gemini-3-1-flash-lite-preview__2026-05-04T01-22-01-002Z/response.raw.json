        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>API Key Management Console</title>\n    <script src=\"https://esm.sh/react@18\"></script>\n    <script src=\"https://esm.sh/react-dom@18/client\"></script>\n    <script src=\"https://unpkg.com/@babel/standalone\"></script>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        body { background: #f8fafc; font-family: sans-serif; }\n        .drawer-enter { transform: translateX(100%); transition: transform 0.3s ease; }\n        .drawer-open { transform: translateX(0); }\n        .status-pill { padding: 2px 8px; border-radius: 999px; font-size: 0.75rem; font-weight: 600; }\n    </style>\n</head>\n<body>\n    <div id=\"root\"></div>\n\n    <script type=\"text/babel\" data-presets=\"react\">\n        const { useState, useMemo } = React;\n\n        const MOCK_DATA = Array.from({ length: 25 }).map((_, i) => ({\n            id: `key-${i}`,\n            name: ['Production-Read', 'Staging-Write', 'CI-Deploy', 'Analytics-Sync', 'Internal-Tool'][i % 5],\n            owner: ['Alice', 'Bob', 'Charlie', 'Dave', 'Eve'][i % 5],\n            scopes: ['read', 'write', 'admin', 'audit'][i % 4],\n            lastUsed: i % 3 === 0 ? '2 hours ago' : i % 3 === 1 ? '14 days ago' : 'Never',\n            created: '2023-10-01',\n            expires: i % 4 === 0 ? '2023-12-01' : '2024-05-20',\n            status: ['healthy', 'stale', 'expiring', 'leaked-suspected', 'revoked'][i % 5]\n        }));\n\n        const StatusPill = ({ status }) => {\n            const colors = {\n                healthy: 'bg-green-100 text-green-700',\n                stale: 'bg-gray-100 text-gray-700',\n                expiring: 'bg-yellow-100 text-yellow-700',\n                'leaked-suspected': 'bg-red-100 text-red-700',\n                revoked: 'bg-slate-200 text-slate-600'\n            };\n            return <span className={`status-pill ${colors[status]}`}>{status.toUpperCase()}</span>;\n        };\n\n        function App() {\n            const [filter, setFilter] = useState('all');\n            const [selected, setSelected] = useState([]);\n            const [drawer, setDrawer] = useState(null);\n\n            const filteredData = useMemo(() => {\n                if (filter === 'all') return MOCK_DATA;\n                return MOCK_DATA.filter(d => d.status === filter || (filter === 'over-scoped' && d.scopes === 'admin'));\n            }, [filter]);\n\n            return (\n                <div className=\"min-h-screen p-4 md:p-8\">\n                    <header className=\"mb-8\">\n                        <h1 className=\"text-2xl font-bold text-slate-900\">API Key Management</h1>\n                        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 mt-6\">\n                            {[{l: 'Total Keys', v: 25}, {l: 'Active', v: 18}, {l: 'Over-scoped', v: 6}, {l: 'Expiring Soon', v: 3}].map(s => (\n                                <div key={s.l} className=\"bg-white p-4 rounded border border-slate-200 shadow-sm\">\n                                    <div className=\"text-xs text-slate-500 uppercase\">{s.l}</div>\n                                    <div className=\"text-2xl font-bold\">{s.v}</div>\n                                </div>\n                            ))}\n                        </div>\n                    </header>\n\n                    <div className=\"bg-white rounded border border-slate-200 shadow-sm overflow-hidden\">\n                        <div className=\"p-4 border-b border-slate-200 flex flex-wrap gap-2 items-center justify-between\">\n                            <input className=\"border rounded px-3 py-1.5 text-sm w-full md:w-64\" placeholder=\"Search keys...\" />\n                            <div className=\"flex gap-1\">\n                                {['all', 'active', 'stale', 'expiring', 'over-scoped'].map(f => (\n                                    <button key={f} onClick={() => setFilter(f)} className={`px-3 py-1 text-xs font-medium rounded ${filter === f ? 'bg-blue-600 text-white' : 'bg-slate-100'}`}>\n                                        {f.charAt(0).toUpperCase() + f.slice(1)}\n                                    </button>\n                                ))}\n                            </div>\n                        </div>\n\n                        <div className=\"overflow-x-auto\">\n                            <table className=\"w-full text-sm text-left\">\n                                <thead className=\"bg-slate-50 text-slate-600 uppercase text-xs\">\n                                    <tr>\n                                        <th className=\"p-3\"><input type=\"checkbox\" /></th>\n                                        {['Name', 'Owner', 'Scopes', 'Last Used', 'Expires', 'Status'].map(h => <th key={h} className=\"p-3\">{h}</th>)}\n                                        <th className=\"p-3\">Actions</th>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    {filteredData.map(row => (\n                                        <tr key={row.id} className=\"border-t border-slate-100 hover:bg-slate-50 cursor-pointer\" onClick={() => setDrawer(row)}>\n                                            <td className=\"p-3\"><input type=\"checkbox\" onClick={(e) => e.stopPropagation()} /></td>\n                                            <td className=\"p-3 font-medium\">{row.name}</td>\n                                            <td className=\"p-3\">{row.owner}</td>\n                                            <td className=\"p-3\">{row.scopes}</td>\n                                            <td className=\"p-3\">{row.lastUsed}</td>\n                                            <td className=\"p-3\">{row.expires}</td>\n                                            <td className=\"p-3\"><StatusPill status={row.status} /></td>\n                                            <td className=\"p-3 text-slate-400\">•••</td>\n                                        </tr>\n                                    ))}\n                                </tbody>\n                            </table>\n                        </div>\n                    </div>\n\n                    {drawer && (\n                        <div className=\"fixed inset-0 bg-black/20 z-50\" onClick={() => setDrawer(null)}>\n                            <div className=\"absolute right-0 top-0 h-full w-full md:w-96 bg-white shadow-xl p-6 overflow-y-auto\" onClick={e => e.stopPropagation()}>\n                                <h2 className=\"text-xl font-bold mb-4\">Audit Log: {drawer.name}</h2>\n                                <div className=\"space-y-4 text-sm\">\n                                    <p><strong>Owner:</strong> {drawer.owner}</p>\n                                    <p><strong>Created:</strong> {drawer.created}</p>\n                                    <div className=\"border-t pt-4\">\n                                        <h3 className=\"font-semibold mb-2\">Recent Events</h3>\n                                        <ul className=\"space-y-2 text-slate-600\">\n                                            <li>• Key rotated 12 days ago</li>\n                                            <li>• Access granted to S3 bucket</li>\n                                            <li>• Last login from 192.168.1.1</li>\n                                        </ul>\n                                    </div>\n                                    <button onClick={() => setDrawer(null)} className=\"mt-8 w-full bg-slate-900 text-white py-2 rounded\">Close</button>\n                                </div>\n                            </div>\n                        </div>\n                    )}\n                </div>\n            );\n        }\n\n        const root = ReactDOM.createRoot(document.getElementById('root'));\n        root.render(<App />);\n    </script>\n</body>\n</html>",
