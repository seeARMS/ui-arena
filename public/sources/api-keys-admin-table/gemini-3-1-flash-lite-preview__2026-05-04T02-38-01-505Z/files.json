[
  {
    "path": "index.html",
    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self' data: blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'none'; media-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; form-action 'none'; base-uri 'none'\" /><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>API Key Manager</title></head>\n  <body><div id=\"root\"></div><script type=\"module\" src=\"/src/main.jsx\"></script></body>\n</html>"
  },
  {
    "path": "package.json",
    "content": "{\n  \"private\": true,\n  \"type\": \"module\",\n  \"name\": \"api-key-manager\",\n  \"version\": \"1.0.0\",\n  \"dependencies\": {\n    \"react\": \"^18.2.0\",\n    \"react-dom\": \"^18.2.0\",\n    \"lucide-react\": \"^0.292.0\",\n    \"clsx\": \"^2.0.0\",\n    \"tailwind-merge\": \"^2.0.0\"\n  },\n  \"devDependencies\": {\n    \"@vitejs/plugin-react\": \"^4.2.0\",\n    \"autoprefixer\": \"^10.4.16\",\n    \"postcss\": \"^8.4.31\",\n    \"tailwindcss\": \"^3.3.5\",\n    \"vite\": \"^5.0.0\"\n  },\n  \"scripts\": {\n    \"build\": \"vite build --base=./\"\n  }\n}\n"
  },
  {
    "path": "postcss.config.js",
    "content": "export default {\n  plugins: {\n    tailwindcss: {},\n    autoprefixer: {},\n  },\n}"
  },
  {
    "path": "src/App.jsx",
    "content": "import React, { useState, useMemo } from 'react';\nimport { Search, MoreVertical, ShieldAlert, Clock, Trash2, RefreshCw, Edit3, ChevronDown, X } from 'lucide-react';\nimport { clsx } from 'clsx';\n\nconst MOCK_DATA = Array.from({ length: 25 }).map((_, i) => ({\n  id: `key-${i}`,\n  name: ['Production-Read', 'Staging-Write', 'CI-Deploy', 'Analytics-Sync', 'Internal-Tool'][i % 5],\n  owner: ['Alice', 'Bob', 'Charlie', 'Dave', 'Eve'][i % 5],\n  scopes: i % 3 === 0 ? ['admin', 'read'] : ['read'],\n  lastUsed: i % 4 === 0 ? '2023-10-25' : '2023-11-01',\n  created: '2023-01-01',\n  expires: i % 5 === 0 ? '2023-11-05' : '2024-01-01',\n  status: ['healthy', 'stale', 'expiring', 'leaked-suspected', 'revoked'][i % 5],\n}));\n\nconst StatusBadge = ({ status }) => {\n  const styles = {\n    healthy: 'bg-green-100 text-green-700',\n    stale: 'bg-slate-100 text-slate-600',\n    expiring: 'bg-amber-100 text-amber-700',\n    'leaked-suspected': 'bg-red-100 text-red-700',\n    revoked: 'bg-gray-200 text-gray-500'\n  };\n  return <span className={clsx('px-2 py-0.5 rounded-full text-xs font-medium', styles[status])}>{status}</span>;\n};\n\nexport default function App() {\n  const [selected, setSelected] = useState([]);\n  const [drawer, setDrawer] = useState(null);\n\n  return (\n    <div className=\"min-h-screen p-4 md:p-8 max-w-7xl mx-auto\">\n      <header className=\"mb-8\">\n        <h1 className=\"text-2xl font-bold mb-4\">API Key Management</h1>\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n          {[\n            { label: 'Total Keys', val: '25' },\n            { label: 'Active', val: '18' },\n            { label: 'Over-scoped', val: '3' },\n            { label: 'Expiring Soon', val: '5' },\n          ].map(stat => (\n            <div key={stat.label} className=\"bg-white p-4 rounded-lg border border-slate-200 shadow-sm\">\n              <div className=\"text-sm text-slate-500\">{stat.label}</div>\n              <div className=\"text-2xl font-semibold\">{stat.val}</div>\n            </div>\n          ))}\n        </div>\n      </header>\n\n      <div className=\"bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden\">\n        <div className=\"p-4 border-b border-slate-200 flex flex-wrap gap-4 items-center justify-between\">\n          <div className=\"relative flex-1 min-w-[200px]\">\n            <Search className=\"absolute left-2 top-2.5 h-4 w-4 text-slate-400\" />\n            <input className=\"w-full pl-8 pr-4 py-2 border rounded-md text-sm\" placeholder=\"Search keys...\" />\n          </div>\n          <div className=\"flex gap-2\">\n            {['All', 'Active', 'Stale', 'Expiring'].map(f => (\n              <button key={f} className=\"px-3 py-1.5 text-sm font-medium rounded-md hover:bg-slate-100\">{f}</button>\n            ))}\n          </div>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-sm text-left\">\n            <thead className=\"bg-slate-50 text-slate-600 uppercase text-xs\">\n              <tr>\n                <th className=\"p-4\"><input type=\"checkbox\" /></th>\n                {['Name', 'Owner', 'Scopes', 'Last Used', 'Expires', 'Status', ''].map(h => <th key={h} className=\"p-4 font-semibold\">{h}</th>)}\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {MOCK_DATA.map(row => (\n                <tr key={row.id} className=\"hover:bg-slate-50 cursor-pointer\" onClick={() => setDrawer(row)}>\n                  <td className=\"p-4\"><input type=\"checkbox\" onClick={e => e.stopPropagation()} /></td>\n                  <td className=\"p-4 font-medium\">{row.name}</td>\n                  <td className=\"p-4\">{row.owner}</td>\n                  <td className=\"p-4\">{row.scopes.join(', ')}</td>\n                  <td className=\"p-4\">{row.lastUsed}</td>\n                  <td className=\"p-4\">{row.expires}</td>\n                  <td className=\"p-4\"><StatusBadge status={row.status} /></td>\n                  <td className=\"p-4 text-right\"><MoreVertical className=\"h-4 w-4\" /></td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {drawer && (\n        <div className=\"fixed inset-0 bg-black/20 z-50 flex justify-end\">\n          <div className=\"w-full max-w-md bg-white h-full shadow-xl p-6 overflow-y-auto\">\n            <div className=\"flex justify-between items-center mb-6\">\n              <h2 className=\"text-lg font-bold\">Key Audit: {drawer.name}</h2>\n              <button onClick={() => setDrawer(null)}><X /></button>\n            </div>\n            <div className=\"space-y-4\">\n              <div className=\"p-4 bg-slate-50 rounded border\">\n                <p className=\"text-xs text-slate-500 uppercase\">Status</p>\n                <p className=\"font-medium\">{drawer.status}</p>\n              </div>\n              <div className=\"space-y-2\">\n                <h3 className=\"font-semibold\">Recent Events</h3>\n                {['Key rotated', 'Scope updated', 'Used by Service-A'].map(e => (\n                  <div key={e} className=\"text-sm py-2 border-b\">{e}</div>\n                ))}\n              </div>\n              <div className=\"flex gap-2 pt-4\">\n                <button className=\"flex-1 bg-red-600 text-white py-2 rounded text-sm\">Revoke</button>\n                <button className=\"flex-1 border py-2 rounded text-sm\">Rotate</button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}"
  },
  {
    "path": "src/index.css",
    "content": "@tailwind base;\n@tailwind components;\n@tailwind utilities;\nbody { @apply bg-slate-50 text-slate-900; }"
  },
  {
    "path": "src/main.jsx",
    "content": "import React from 'react';\nimport ReactDOM from 'react-dom/client';\nimport App from './App';\nimport './index.css';\n\nReactDOM.createRoot(document.getElementById('root')).render(<App />);"
  },
  {
    "path": "src/styles.css",
    "content": ""
  },
  {
    "path": "tailwind.config.js",
    "content": "/** @type {import('tailwindcss').Config} */\nexport default {\n  content: [\"./index.html\", \"./src/**/*.{js,ts,jsx,tsx}\"],\n  theme: { extend: {} },\n  plugins: [],\n}"
  }
]
